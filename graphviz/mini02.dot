graph "mini02" {
	node [fontname="Helvetica"];
	edge [fontname="Helvetica", fontsize=10];
	n0 [shape=circle, label="0"];
	n1 [shape=circle, label="1"];
	n2 [shape=circle, label="2"];
	n3 [shape=circle, label="3"];
	n4 [shape=box, label="{3, 9}"];
	n5 [shape=box, label="{8, 9}"];
	n6 [shape=box, label="{9, 10}"];
	n7 [shape=box, label="{4, 10}"];
	n8 [shape=circle, label="8"];
	n9 [shape=circle, label="9"];
	n10 [shape=circle, label="10"];
	n11 [shape=circle, label="11"];
	n12 [shape=box, label="{1, 6}"];
	n13 [shape=box, label="{1, 8}"];
	n14 [shape=box, label="{4, 6}"];
	n15 [shape=box, label="{6, 7}"];
	n16 [shape=circle, label="16"];
	n17 [shape=circle, label="17"];
	n18 [shape=circle, label="18"];
	n19 [shape=box, label="{2, 5}"];
	n20 [shape=box, label="{2, 8}"];
	n21 [shape=box, label="{3, 5}"];
	n22 [shape=box, label="{5, 7}"];
	n0 -- n1 [label="{3, 4, 8}"];
	n0 -- n8 [label="{3, 4, 8}"];
	n1 -- n2 [label="{3, 8, 10}"];
	n1 -- n7 [label="{4, 10}"];
	n2 -- n3 [label="{3, 8, 9}"];
	n2 -- n6 [label="{9, 10}"];
	n3 -- n4 [label="{3, 9}"];
	n3 -- n5 [label="{8, 9}"];
	n8 -- n9 [label="{4, 7, 8}"];
	n8 -- n16 [label="{3, 7, 8}"];
	n9 -- n10 [label="{4, 6, 8}"];
	n9 -- n15 [label="{6, 7}"];
	n10 -- n11 [label="{6, 8}"];
	n10 -- n14 [label="{4, 6}"];
	n11 -- n12 [label="{1, 6}"];
	n11 -- n13 [label="{1, 8}"];
	n16 -- n17 [label="{3, 5, 8}"];
	n16 -- n22 [label="{5, 7}"];
	n17 -- n18 [label="{5, 8}"];
	n17 -- n21 [label="{3, 5}"];
	n18 -- n19 [label="{2, 5}"];
	n18 -- n20 [label="{2, 8}"];
}
